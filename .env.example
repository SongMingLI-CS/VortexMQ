# VortexMQ 本地开发环境变量模板
# 复制为 .env 后按实际环境修改

# PostgreSQL 异步连接串，驱动必须使用 asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vortexmq

# Redis Streams 管道。数据面实际键为 {tenant_id}:vortex:tasks:stream，兼容 Cluster 同 slot
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=vortex
REDIS_STREAM_KEY=vortex:tasks:stream
REDIS_DELAYED_KEY=vortex:tasks:delayed
REDIS_CONSUMER_GROUP=vortex:workers
REDIS_STREAM_MAXLEN=100000
REDIS_PRIORITY_HIGH_THRESHOLD=50

# 控制面选主：多 API 副本时只有 Leader 跑 Outbox Sweeper 与 Delay Dispatcher
CONTROL_LEADER_TTL_MS=10000
CONTROL_LEADER_RENEW_SECONDS=3

# Outbox 补偿、延迟调度与指数退避
OUTBOX_SWEEP_INTERVAL_SECONDS=10
OUTBOX_STALE_SECONDS=30
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_DELAY_SECONDS=5
# Worker 单进程最大并发在途消息数（>1 时预取并行；并发高请同步调大 PG 连接池）
WORKER_MAX_IN_FLIGHT=4
DELAY_DISPATCH_INTERVAL_SECONDS=1
WORKER_METRICS_PORT=8001

# 租户 API Key 不再写进环境变量。签发（明文只打印一次）：
#   python -m app.cli create-tenant default
# 压测把打印出的 Key 传给 scripts/stress_test.py --api-key <key>

# 应用开关（默认关闭，避免 SQL/payload 泄漏到日志；需要时才打开）
DEBUG=false
# SQLAlchemy engine echo（独立于 DEBUG，生产请保持 false）
SQL_ECHO=false

# 管理面 API 凭证（X-Admin-Key）。必须设置，否则 /api/v1/admin/** 返回 503。
# 生产环境请用 secrets 工具生成随机长串，例如: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
