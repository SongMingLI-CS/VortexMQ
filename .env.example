# VortexMQ 本地开发环境变量模板
# 复制为 .env 后按实际环境修改

# PostgreSQL 异步连接串，驱动必须使用 asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vortexmq

# Redis Streams 管道。数据面实际键为 {tenant_id}:vortex:tasks:stream，兼容 Cluster 同 slot
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=vortex
REDIS_STREAM_KEY=vortex:tasks:stream
REDIS_DELAYED_KEY=vortex:tasks:delayed
REDIS_CONSUMER_GROUP=vortex:workers
REDIS_STREAM_MAXLEN=100000
REDIS_PRIORITY_HIGH_THRESHOLD=50

# 控制面选主：多 API 副本时只有 Leader 跑 Outbox Sweeper 与 Delay Dispatcher
CONTROL_LEADER_TTL_MS=10000
CONTROL_LEADER_RENEW_SECONDS=3

# Outbox 补偿、延迟调度与指数退避
OUTBOX_SWEEP_INTERVAL_SECONDS=10
OUTBOX_STALE_SECONDS=30
OUTBOX_BATCH_SIZE=20
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_DELAY_SECONDS=5
# Worker 单进程最大并发在途消息数（>1 时预取并行；并发高请同步调大 PG 连接池）
WORKER_MAX_IN_FLIGHT=4
# 空闲等待毫秒数：无消息时用 XREADGROUP BLOCK 阻塞等待新消息 / 停机信号
WORKER_BLOCK_MS=5000
# PEL 中空闲超过该毫秒数的消息可被其他 Worker XAUTOCLAIM；
# 同时也是 Outbox 回收僵死 RUNNING 与 Worker CAS 允许回收的租约窗口
WORKER_CLAIM_IDLE_MS=30000
# 长任务租约心跳间隔（秒），必须明显小于 WORKER_CLAIM_IDLE_MS
WORKER_LEASE_HEARTBEAT_SECONDS=5
# Worker 心跳有效期（秒）：超过该时长没心跳的节点从 /admin/workers 消失
WORKER_HEARTBEAT_TTL_SECONDS=15
# 留空时 Worker 用 hostname-pid 生成唯一消费者名；固定消费者名会在重启时先排空自身 PEL
WORKER_CONSUMER_NAME=
DELAY_DISPATCH_INTERVAL_SECONDS=1
DELAY_DISPATCH_BATCH_SIZE=100
WORKER_METRICS_PORT=8001

# 租户 API Key 不再写进环境变量。签发（明文只打印一次）：
#   python -m app.cli create-tenant default
# 压测把打印出的 Key 传给 scripts/stress_test.py --api-key <key>

# 应用开关（默认关闭，避免 SQL/payload 泄漏到日志；需要时才打开）
DEBUG=false
# SQLAlchemy engine echo（独立于 DEBUG，生产请保持 false）
SQL_ECHO=false
# 启动期建表兜底。默认 true 让本地/compose 免手工迁移即可跑；
# 生产多副本请设为 false，并在部署流水线执行 python -m alembic upgrade head
AUTO_CREATE_SCHEMA=true

# 管理面 API 凭证（X-Admin-Key）。必须设置，否则 /api/v1/admin/** 返回 503。
# 生产环境请用 secrets 工具生成随机长串，例如: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=

# AI Handler（task_type=ai.deepseek.chat）
# 真实模型凭证。留空时该 Handler 会显式失败并进入重试 / DLQ，不会返回假数据。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# 单次模型调用超时（秒）
DEEPSEEK_TIMEOUT_SECONDS=120
# max_tokens 上限，防止调用方用 payload 把生成预算写到天文数字
AI_MAX_TOKENS_LIMIT=8192
# 离线模拟开关。仅本地演示 / CI 无外部依赖时设为 true；生产必须保持 false
AI_MOCK_ENABLED=false

# 内置演示 Handler 开关（demo.sleep / demo.echo / demo.noop / demo.fail）。
# 本地开发、压测与 CI 需要 true；生产建议 false，避免租户用 demo.* 占用执行槽位。
ENABLE_DEMO_HANDLERS=true

